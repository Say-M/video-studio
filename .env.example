# Copy this file to .env and fill in your keys. .env is git-ignored.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional default voice (can be overridden per client/project)
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2

# Cartesia — https://play.cartesia.ai/keys
CARTESIA_API_KEY=
CARTESIA_DEFAULT_VOICE_ID=
CARTESIA_DEFAULT_MODEL=sonic-3.6

# Stability AI (Stable Audio) — https://platform.stability.ai/account/keys
STABILITY_API_KEY=
