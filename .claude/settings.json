{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/status.mjs --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/status.mjs:*)",
      "Bash(node scripts/frames.mjs:*)",
      "Bash(node scripts/new-project.mjs:*)",
      "Bash(npx tsc:*)",
      "Bash(npx remotion still:*)",
      "Bash(npx remotion studio:*)",
      "Bash(npx remotion ffprobe:*)",
      "Bash(npm run status:*)",
      "Bash(npm run typecheck:*)"
    ],
    "ask": [
      "Bash(node scripts/tts.mjs:*)",
      "Bash(node scripts/music.mjs:*)"
    ]
  }
}
